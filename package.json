{
  "name": "approval-system",
  "version": "1.1.0",
  "description": "線上簽核系統 - 自訂流程、紀錄留存、PDF 匯出",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "init-admin": "node server/seed.js",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:ubuntu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ubuntu-installer.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@signpdf/placeholder-plain": "^3.2.4",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.4",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "xlsx": "^0.18.5"
  }
}
